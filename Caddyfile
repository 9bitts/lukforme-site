{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	encode {
		gzip
		zstd
	}

	root * {{.StaticFileRoot}}

	handle /health {
		respond 200
	}

	# /index.html vira a raiz; as outras páginas perdem o .html
	handle /index.html {
		redir * /{http.request.uri.prefixed_query} 301
	}

	@html path_regexp ext ^(/.*)\.html$
	handle @html {
		redir * {re.ext.1}{http.request.uri.prefixed_query} 301
	}

	handle {
		try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}
		file_server {
			hide .git
			hide .env*
		}
	}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
